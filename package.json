{
  "name": "crypto-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "hash-password": "node scripts/hash-password.mjs",
    "db:indexes": "tsx --conditions=react-server scripts/ensure-indexes.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.66.0",
    "mongodb": "^7.8.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.47.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
